
# NASA API Configuration
NASA_API_KEY=YOUR_NASA_API_KEY_HERE
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_MODIS_BASE_URL=https://modis.ornl.gov/rst/api/v1
NASA_SMAP_BASE_URL=https://n5eil01u.ecs.nsidc.org/egi/request
NASA_GRACE_BASE_URL=https://grace.jpl.nasa.gov/api
NASA_MAP_API_KEY=YOUR_NASA_MAP_API_KEY_HERE

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
CACHE_DIR=./data/cache
OUTPUT_DIR=./data/output

# Default location (can be overridden via CLI)
DEFAULT_LATITUDE=40.7128
DEFAULT_LONGITUDE=-74.0060
DEFAULT_START_YEAR=2020
DEFAULT_END_YEAR=2024